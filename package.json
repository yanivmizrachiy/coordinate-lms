{
  "name": "coordinate-lms",
  "version": "1.0.0",
  "description": "מערכת צירים — הרביע הראשון: המקור היחיד של חוברת 78 העמודים — הדפסה, חוברת דיגיטלית ו-LMS מתוקשב מאותו תוכן קנוני.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4319 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firestore": "node scripts/run-firestore-emulator-tests.mjs",
    "test:visual": "playwright test",
    "typecheck": "tsc --noEmit",
    "answers:coverage": "node scripts/generate-answer-coverage.mjs",
    "answers:coverage:check": "node scripts/generate-answer-coverage.mjs --check",
    "firebase:check": "node scripts/firebase-readiness.mjs",
    "firebase:connect": "node scripts/connect-firebase.mjs",
    "firebase:check:static": "node scripts/firebase-readiness.mjs --static",
    "release:report": "node scripts/release-readiness.mjs",
    "release:report:static": "node scripts/release-readiness.mjs --static",
    "release:check": "npm run verify && npm audit --audit-level=high && npm audit --omit=dev --audit-level=high && npm run release:report",
    "verify": "npm run answers:coverage:check && npm run typecheck && npm test && npm run test:firestore && npm run build && npm run test:visual",
    "pdf": "node scripts/build-pdf.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "firebase": "^12.18.0",
    "pdf-lib": "^1.17.1"
  }
}
